ghcr.io/

# LaTeX build artifacts
docs/*.aux
docs/*.bbl
docs/*.blg
docs/*.dvi
docs/*.fdb_latexmk
docs/*.fls
docs/*.log
docs/*.out
docs/*.pdf
docs/*.synctex.gz
docs/*.toc

# Python
__pycache__/
*.pyc

# analysis intermediates (regenerate with extract.py)
data/analysis/*.csv

# detect 用の vuls 設定は data/bin/detect.sh が生成する
data/*/config.*.toml

# 検知に使う vuls v1 のバイナリ。commit してあるのは data/vuls.zst の方で、
# 展開後の data/vuls は無視する（data/bin/unpack-db.sh が展開する）
data/vuls
!data/vuls.zst
